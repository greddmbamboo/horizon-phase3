# Local dev: leave HORIZON_STORE unset to share a JSON file between both apps (<repo>/.data/state.json).
# Deployed: both apps must point at the SAME Supabase project so changes are shared.
HORIZON_STORE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# The other app's URL, used for the "Open the other app" link in the demo panel.
NEXT_PUBLIC_OTHER_APP_URL=http://localhost:3000
