{
  "name": "horizon-outreach",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "web",
    "portal",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:operator": "npm run dev -w web",
    "dev:client": "npm run dev -w portal",
    "build": "npm run build -w web && npm run build -w portal",
    "type-check": "npm run type-check --workspaces --if-present",
    "reset-data": "node scripts/reset-data.mjs"
  },
  "overrides": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
