{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs"
    },
    "portal": {
      "root": "portal",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/portal", "destination": { "service": "portal" } },
    { "source": "/portal/(.*)", "destination": { "service": "portal" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
